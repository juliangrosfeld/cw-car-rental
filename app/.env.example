# Copy to .env for local dev. Real values are never committed (.env is gitignored).
# On Vercel, add these under Project Settings → Environment Variables.
#
# All three come from the Supabase dashboard: Project Settings → API keys.
# This project uses the current-generation keys (sb_publishable_… / sb_secret_…)
# rather than the legacy JWT anon/service_role pair; supabase-js accepts either.

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC — these two reach the browser by design.
#
# vite.config.ts maps them onto import.meta.env.VITE_SUPABASE_URL /
# VITE_SUPABASE_ANON_KEY for the client bundle, so there is no need to define a
# duplicate VITE_-prefixed pair (setting one anyway will take precedence).
#
# The publishable/anon key is MEANT to be public. Row Level Security is what
# protects the data, not the secrecy of this key.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# SECRET — server only. BYPASSES Row Level Security entirely.
#
# Never prefix this with VITE_, never add it to the `define` allowlist in
# vite.config.ts, never import it outside a .server.ts file, never log it.
# Read it only through src/lib/supabase/admin.server.ts.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend) — booking confirmation to the guest, new-booking alert to Clay.
#
# Optional, by design: with these unset, bookings still go through and each
# skipped email is logged as "[email] … SKIPPED booking=<id>". A Resend outage
# is logged as "[email] … FAILED" and likewise never fails a booking.
#
# RESEND_API_KEY is SECRET — server only. Anyone holding it can send mail as
# the verified domain. From resend.com → API Keys ("Sending access" is enough).
# Never prefix it with VITE_, never add it to the `define` allowlist in
# vite.config.ts, never import it outside a .server.ts file, never log it.
# Read it only through src/lib/email/resend.server.ts.
#
# EMAIL_FROM must be an address on a domain verified in Resend (Domains),
# otherwise every send is rejected with a 403.
#
# ADMIN_NOTIFY_EMAIL is where new-booking alerts go (Clay). Guests' replies to
# their confirmation also land here.
#
# Commented out so a straight copy of this file means "email off", not "email
# on with a fake key".
# ─────────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="CW Car Rental <bookings@cwcarrental.com>"
# ADMIN_NOTIFY_EMAIL=clay@example.com

# ─────────────────────────────────────────────────────────────────────────────
# Build target. Unset (or anything other than "cloudflare") builds for Vercel —
# which is what Vercel's zero-config build does, since it sets no such variable.
# Set to "cloudflare" only to reproduce the original Higgsfield/Workers build.
# ─────────────────────────────────────────────────────────────────────────────
# DEPLOY_TARGET=cloudflare
